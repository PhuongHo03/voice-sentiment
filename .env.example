# ==============================================================================
# Master .env.example - voice-sentiment System Configuration Template
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# ─── Cấu hình Cổng & Địa chỉ liên kết (Ports & Bind Configuration) ────────────
# Địa chỉ IP liên kết (0.0.0.0 = Mở LAN, 127.0.0.1 = Chỉ nội bộ Localhost)
APP_BIND_IP=0.0.0.0
LOCAL_BIND_IP=127.0.0.1

# Cổng các giao diện quản trị & Web (UI Ports - Sắp xếp tăng dần)
NGINX_PORT=9090
ADMINER_PORT=9091
MINIO_CONSOLE_PORT=9092
REDISINSIGHT_PORT=9093
RABBITMQ_MANAGEMENT_PORT=9094
PROMETHEUS_PORT=9095

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_DB=voice_sentiment
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_HOST=redis

# ─── Queue (RabbitMQ) ─────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_COUNT=2

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio

# ─── Backend Service ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9090

# ─── Frontend Service ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=

# ─── Monitoring (Prometheus - internal only, queried by backend) ──────────────

# ─── Voice ASR Service (Stateless voice-worker) ──────────────────────────────
VOICE_LANGUAGE_CODE=auto
PYTHONUNBUFFERED=1

# ─── LLM Analysis Worker Service (llm-worker) ─────────────────────────────────
VOICE_SERVER_URI=http://voice-worker:8000
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
