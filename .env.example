# ==============================================================================
# Master .env.example - voice-sentiment System Configuration Template
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_DB=voice_sentiment
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
DATABASE_URL=postgresql+psycopg://voice:voice@postgres:5432/voice_sentiment

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Queue (RabbitMQ) ─────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
RABBITMQ_QUEUE_COUNT=2

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# ─── Backend Service ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9090

# ─── Frontend Service ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=

# ─── Monitoring (Prometheus - internal only, queried by backend) ──────────────
PROMETHEUS_URL=http://prometheus:9090

# ─── Voice ASR Service (Stateless voice-worker) ──────────────────────────────
VOICE_LANGUAGE_CODE=auto
PYTHONUNBUFFERED=1

# ─── LLM Analysis Worker Service (llm-worker) ─────────────────────────────────
VOICE_SERVER_URI=http://voice-worker:8000
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
